{
  "name": "barber-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "media": "node scripts/media.mjs",
    "todo": "grep -rn \"\\[TODO\\]\" content/*.json content/*.md src 2>/dev/null || true",
    "preview:build": "node scripts/build-preview.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "serve": "astro preview --port 4330",
    "check": "node tests/check-availability.mjs && astro build && FIXTURE=1 OUT_DIR=dist-test astro build && node tests/check-booking.mjs",
    "og": "node scripts/make-og.mjs",
    "lighthouse": "sh scripts/lighthouse.sh"
  },
  "devDependencies": {
    "fontkit": "^2.0.4",
    "playwright": "^1.65.1",
    "sharp": "^0.34.0"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "astro": "^7.4.12"
  }
}
